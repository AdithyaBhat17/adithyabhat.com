---
import PageLayout from '@/layouts/PageLayout.astro';
import Painting from '@/components/journal/Painting.astro';
import BuildSheet from '@/components/work/BuildSheet.astro';
import garage from '@/assets/paintings/builds-garage.png';
import { fetchWithFallback } from '@/lib/datocms';
import { RECENT_WORK, RECENT_WORK_LEGACY } from '@/graphql/work';
import { buildMeta } from '@/lib/projects';
import type { Project } from '@/types/content';

const data = await fetchWithFallback(RECENT_WORK, RECENT_WORK_LEGACY);
const projects = ((data.allProjects ?? []) as Project[]).map((p) => ({ ...p, meta: buildMeta(p) }));
const mine = projects.filter((p) => p.meta?.group === 'me');
const work = projects.filter((p) => p.meta?.group === 'work');
const clients = projects.filter((p) => p.meta?.group !== 'me' && p.meta?.group !== 'work');
const ROT_A = [-1.5, 1, -2];
const ROT_B = [2, -1.2, 1.5];
---

<PageLayout image="/brand/og/work.png" imageAlt="A painted desert garage with the KTM and the Honda, under the title “Builds”." title="Builds | Adithya NR" description="Things I’ve designed and shipped: tools I built for myself, and products for clients.">
  <section class="wrap page-head">
    <h1 class="display-xl">Builds</h1>
    <p class="body-l lede">Things I’ve designed and shipped. Lately most of them are tools I built for myself, because the best way to know a product works is to use it every day.</p>
  </section>

  <Painting
    src={garage}
    alt="A sunlit desert garage in the afternoon, door open, with the KTM and the Honda parked inside and a chalkboard sign pointing in."
    w={1440}
    h={600}
    focusX={760}
    tint
    ink={false}
    priority
  />

  <section class="section group" aria-labelledby="mine-title">
    <div class="wrap">
      <div class="group-head">
        <h2 id="mine-title" class="display-l">Built for me</h2>
        <p class="hand aside" data-ink-in data-observe>used every single day</p>
      </div>
      <div class="boards">
        {mine.map((p, i) => (
          <BuildSheet slug={p.slug} title={p.title} date={String(p.date)} tags={p.tags} link={p.link} image={p.thumbnail?.responsiveImage} meta={p.meta} rot={ROT_A[i % 3]} />
        ))}
      </div>
    </div>
  </section>

  {work.length > 0 && (
    <section class="section group" aria-labelledby="work-title">
      <div class="wrap">
        <div class="group-head">
          <h2 id="work-title" class="display-l">Built at work</h2>
          <p class="hand aside" data-ink-in data-observe>at yellow.ai</p>
        </div>
        <div class="boards">
          {work.map((p, i) => (
            <BuildSheet slug={p.slug} title={p.title} date={String(p.date)} tags={p.tags} link={p.link} image={p.thumbnail?.responsiveImage} meta={p.meta} rot={ROT_B[(i + 1) % 3]} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section group" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="group-head">
        <h2 id="clients-title" class="display-l">Built for clients</h2>
        <p class="hand aside" data-ink-in data-observe>from before the garage got busy</p>
      </div>
      <div class="boards">
        {clients.map((p, i) => (
          <BuildSheet slug={p.slug} title={p.title} date={String(p.date)} tags={p.tags} link={p.link} image={p.thumbnail?.responsiveImage} meta={p.meta} rot={ROT_B[i % 3]} />
        ))}
        <p class="more hand">more on <a href="https://github.com/adithyabhat17" target="_blank" rel="noopener noreferrer">GitHub</a> and <a href="https://dribbble.com/adithyanr" target="_blank" rel="noopener noreferrer">Dribbble</a> →</p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .page-head {
    display: flex;
    align-items: flex-end;
    gap: 60px;
    padding-top: 80px;
    padding-bottom: 40px;
  }
  .lede {
    max-width: 520px;
    margin-bottom: 4px;
  }
  .group {
    padding-top: 110px;
  }
  @media (max-width: 767px) {
    .group {
      padding-top: 64px;
    }
  }
  .group-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 40px;
  }
  .aside {
    font-size: 28px;
    color: var(--orange);
  }
  .boards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 400px));
    justify-content: space-between;
    align-items: start;
    gap: 40px;
  }
  .boards > :global(:nth-child(2)) {
    margin-top: 8px;
  }
  .more {
    font-size: 30px;
    line-height: 1.2;
    color: var(--ink);
  }
  .more a {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-underline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .boards {
      grid-template-columns: repeat(2, minmax(0, 400px));
      justify-content: start;
    }
  }
  @media (max-width: 767px) {
    .page-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-top: 32px;
      padding-bottom: 24px;
    }
    .boards {
      grid-template-columns: minmax(0, 400px);
      justify-content: center;
      gap: 32px;
    }
    .aside {
      font-size: 24px;
    }
    .more {
      font-size: 26px;
    }
  }
</style>
