---
import { Picture } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Painting from '@/components/journal/Painting.astro';
import portrait from '@/assets/about/portrait.png';
import hills from '@/assets/about/misty-hills.png';
import figKtm from '@/assets/about/fig-ktm.png';
import toolbox from '@/assets/about/toolbox.png';
import offDuty from '@/assets/about/off-duty.png';
import service from '@/assets/paintings/service.png';
import serviceFg from '@/assets/paintings/service-fg.png';
import { ROUTE } from '@/data/career';

const SPECS: [string, string][] = [
  ['Model', 'Adithya NR'],
  ['Based in', 'Abu Dhabi, UAE'],
  ['Engine', 'Design and engineering'],
  ['Mileage', '7 years'],
  ['Current tune', 'SDE-3 at yellow.ai, on the Agentic AI platform'],
  ['Languages', 'English, Hindi, Kannada'],
  ['Design kit', 'UX, UI, wireframing, prototyping, design systems'],
  ['Code kit', 'TypeScript, React, Next.js, Node.js, GraphQL, PostgreSQL, Playwright'],
  ['Daily tools', 'Figma, Cursor, Claude Code, Git'],
  ['Fuel', 'Moka pot on weekdays, espresso on weekends'],
];
const ledger = [...ROUTE].reverse();
---

<PageLayout title="About | Adithya NR" description="Adithya NR is a product engineer in Abu Dhabi who designs interfaces and then builds them.">
  <section class="wrap about-hero">
    <div class="intro">
      <h1 class="display-xl">The owner’s manual</h1>
      <p class="body-l">I’m Adithya, a product engineer in Abu Dhabi. For more than seven years, design has been the centre of my work. I started as a graphic designer, moved into UX, and these days I design the interface and then build it.</p>
      <p class="body-l">I’ve worked with startups and teams around the world. Right now I’m shaping the Agentic AI platform at <a class="text-link" href="https://yellow.ai/" target="_blank" rel="noopener noreferrer">yellow.ai</a>.</p>
      <div class="actions">
        <a class="btn btn--ink" href="/resume.pdf" target="_blank" rel="noopener" data-sound-hover="tick">
          Download my CV
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v9M4 8.5l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="btn btn--ghost" href="/contact" data-sound-hover="tick">Say hello</a>
      </div>
    </div>
    <div class="portrait" data-reveal>
      <Picture src={portrait} formats={['avif', 'webp']} widths={[473]} sizes="(max-width: 767px) 88vw, 473px" alt="Adithya standing on a foggy hillside in a dark hoodie; with the caption “me, on a foggy morning ride”." loading="eager" fetchpriority="high" />
    </div>
  </section>

  <Painting src={hills} alt="Misty green hills with pine trees and a road, a small motorcycle on it; a note reads “where I go to think”." w={1440} h={420} ink={false} focusX={900} mobileScale={0.7} tint />

  <section class="section wrap specs" aria-labelledby="spec-title">
    <div class="spec-sheet">
      <h2 id="spec-title" class="display-l">Specifications</h2>
      <dl>
        {SPECS.map(([k, v]) => (
          <div class="spec-row"><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
    <figure class="fig" data-reveal>
      <Picture src={figKtm} formats={['avif', 'webp']} widths={[521]} sizes="(max-width: 767px) 88vw, 521px" alt="Fig. 1, a pencil-style drawing of the KTM 390 Adventure (2025), with notes on the tall screen, the Acerbis handguards and the 399cc single." loading="lazy" />
    </figure>
  </section>

  <section class="section service" aria-labelledby="service-title">
    <div class="wrap section-head">
      <h2 id="service-title" class="display-l">Service history</h2>
    </div>
    <Painting src={service} alt="A wooden workbench with a toolbox, spanner and oil stains under an open service book." w={1440} h={640} ink={false} focusX={720} tint>
      <Picture src={serviceFg} formats={['avif', 'webp']} widths={[1440]} sizes="100vw" alt="" class="service-fg" loading="lazy" />
      <div class="ledger-wrap" slot="outer">
        <table class="ledger grain">
          <caption class="sr-only">Service history: where I’ve worked</caption>
          <thead>
            <tr><th scope="col">Date</th><th scope="col">Workshop</th><th scope="col">Work done</th><th scope="col">Signed off</th></tr>
          </thead>
          <tbody>
            {ledger.map((s) => (
              <tr>
                <td class="l-date">{s.year}</td>
                <th scope="row" class="l-shop">{s.company}</th>
                <td class="l-work">{s.work}</td>
                <td class="l-sign">
                  <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" /><path d="M10 16.5l4 4 8-9" /></svg>
                  <span class="hand">{s.current ? 'in progress' : 'passed'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Painting>
  </section>

  <section class="section stickers" aria-labelledby="stickers-title">
    <div class="wrap section-head">
      <h2 id="stickers-title" class="display-l">Stickers on the toolbox</h2>
    </div>
    <Painting src={toolbox} alt="An orange toolbox lid covered in stickers from yellow.ai, Softway, Daikin, Dish, Betsol and Homero, plus a WCAG AA badge, “ship it”, “390 Adventure”, an Abu Dhabi postmark and “dirt > traffic”." w={1440} h={560} ink={false} mobileScale={0.6} mobileSwipe />
  </section>

  <section class="section off-duty" aria-labelledby="off-title">
    <div class="wrap">
      <h2 id="off-title" class="display-l section-head">Off duty</h2>
      <p class="body-l off-copy">When I’m not at a keyboard, I’m usually riding. Long road days, weekend off-road trails, or a ride out for good coffee.</p>
    </div>
    <Painting src={offDuty} alt="Three ride photos taped over a dusk mountain painting, captioned “blue hour on the 390”, “dirt days in the hills” and “helmet on, lift going down”." w={1440} h={660} ink={false} mobileScale={0.55} mobileSwipe tint />
  </section>
</PageLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 724px) 473px;
    justify-content: space-between;
    align-items: start;
    gap: 40px;
    padding-top: 90px;
    padding-bottom: 60px;
  }
  .intro {
    padding-top: 30px;
  }
  .intro .body-l {
    max-width: 600px;
    margin-top: 26px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
  }

  .specs {
    display: grid;
    grid-template-columns: minmax(0, 680px) minmax(0, 521px);
    justify-content: space-between;
    gap: 60px;
    padding-top: 120px;
  }
  .spec-sheet dl {
    margin: 28px 0 0;
  }
  .spec-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .spec-row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .spec-row dt {
    padding-top: 2px;
    font-size: 13px;
    color: var(--ink-meta);
  }
  .spec-row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.3;
  }
  .fig {
    margin: 0;
  }
  .fig :global(img) {
    width: 100%;
    height: auto;
  }
  [data-theme='dark'] .fig :global(img) {
    filter: invert(0.88) hue-rotate(180deg) saturate(0.7);
  }

  .service :global(.service-fg),
  .service :global(.service-fg img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }
  .ledger-wrap {
    --u: calc(100cqw / 1440);
    position: absolute;
    left: calc(200 * var(--u));
    top: calc(144 * var(--u));
    width: calc(1039 * var(--u));
    rotate: -1.2deg;
    z-index: 2;
  }
  .ledger {
    width: 100%;
    border-collapse: collapse;
    background: #fbf7ee;
    color: #1c2124;
    box-shadow: calc(4 * var(--u)) calc(14 * var(--u)) calc(24 * var(--u)) rgba(30, 18, 6, 0.4);
    font-size: max(11px, calc(11 * var(--u)));
  }
  .ledger th,
  .ledger td {
    padding: calc(14 * var(--u)) calc(14 * var(--u));
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid rgba(28, 33, 36, 0.12);
  }
  .ledger thead th {
    padding-top: calc(22 * var(--u));
    font-size: max(10px, calc(9 * var(--u)));
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #6b6659;
  }
  .ledger tbody tr:last-child > * {
    border-bottom: 0;
  }
  .ledger th:first-child,
  .ledger td:first-child {
    padding-left: calc(40 * var(--u));
    width: calc(150 * var(--u));
  }
  .l-shop {
    width: calc(180 * var(--u));
    font-family: var(--font-display);
    font-weight: 400;
    font-size: max(14px, calc(16 * var(--u)));
  }
  .l-work {
    color: #464b4d;
  }
  .l-sign {
    width: calc(190 * var(--u));
    white-space: nowrap;
  }
  .l-sign svg {
    display: inline-block;
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
    vertical-align: middle;
    fill: none;
    stroke: #e2560b;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .l-sign .hand {
    margin-left: calc(8 * var(--u));
    font-size: max(17px, calc(19 * var(--u)));
    color: #e2560b;
    vertical-align: middle;
  }

  .off-copy {
    max-width: 640px;
    margin-bottom: 32px;
  }

  @media (max-width: 1100px) {
    .about-hero,
    .specs {
      grid-template-columns: 1fr;
    }
    .portrait,
    .fig {
      max-width: 473px;
    }
  }
  @media (max-width: 767px) {
    .about-hero {
      padding-top: 32px;
      gap: 32px;
    }
    .intro {
      padding-top: 0;
    }
    .specs {
      padding-top: 72px;
      gap: 40px;
    }
    .spec-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .spec-row dd {
      font-size: 17px;
    }
    .ledger-wrap {
      --u: 1px;
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      margin: -560px var(--gutter) 0;
      rotate: -1deg;
    }
    .ledger thead {
      display: none;
    }
    .ledger tr {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 2px 12px;
      padding: 14px 16px;
      border-bottom: 1px solid rgba(28, 33, 36, 0.12);
    }
    .ledger th,
    .ledger td {
      display: block;
      width: auto !important;
      padding: 0 !important;
      border: 0;
    }
    .l-work {
      grid-column: 1 / -1;
    }
    .service :global(.painting) {
      height: 640px;
    }
  }
</style>
