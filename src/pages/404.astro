---
import PageLayout from '@/layouts/PageLayout.astro';
import Painting from '@/components/journal/Painting.astro';
import fork from '@/assets/paintings/desert-fork.png';
---

<PageLayout title="Page not found | Adithya NR" description="This road doesn’t go anywhere." cta={false}>
  <meta slot="head" name="robots" content="noindex" />
  <section class="wrap nf">
    <h1 class="display-xl">This road doesn’t go anywhere.</h1>
    <p class="body-l">The page you were looking for has moved, or it never existed. Here’s the way back.</p>
    <div class="actions">
      <a class="btn btn--ink" href="/" data-sound-hover="tick">
        Back home
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.3 8H12M8.7 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a class="btn btn--ghost" href="/work" data-sound-hover="tick">See my work</a>
    </div>
  </section>
  <Painting src={fork} alt="A desert road at dusk forking at a signpost; one arm points home." w={1440} h={600} ink={false} focusX={720} mobileScale={0.65} priority tint />
  <div class="spacer" aria-hidden="true"></div>
</PageLayout>

<style>
  .nf {
    padding-top: 80px;
    padding-bottom: 48px;
  }
  .nf .body-l {
    max-width: 560px;
    margin-top: 22px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .spacer {
    height: 120px;
  }
  @media (max-width: 767px) {
    .nf {
      padding-top: 32px;
    }
    .spacer {
      height: 64px;
    }
  }
</style>
