---
import PageLayout from '@/layouts/PageLayout.astro';
import Painting from '@/components/journal/Painting.astro';
import PhotoGallery from '@/components/react/PhotoGallery';
import darkroom from '@/assets/paintings/darkroom.png';
import { fetchGalleryAPI } from '@/lib/datocms';
import { GALLERY_PHOTOS } from '@/graphql/photos';

const data = await fetchGalleryAPI(GALLERY_PHOTOS);
const places = data.allPlaces ?? [];
const totalPhotos = places.reduce((sum: number, p: any) => sum + (p.photos?.length ?? 0), 0);
const states = new Set(places.map((p: any) => p.state).filter(Boolean)).size;
const cameras = new Set(places.map((p: any) => p.camera).filter(Boolean)).size;
const stats = [
  [totalPhotos, 'photos'],
  [places.length, 'places'],
  [states, 'states'],
  [cameras, cameras === 1 ? 'camera' : 'cameras'],
] as const;
---

<PageLayout image="/brand/og/photos.png" imageAlt="Prints drying on a line in a red darkroom, under the title “Photos”." title="Photos | Adithya NR" description="Photos from trips and everyday life.">
  <section class="wrap page-head">
    <div>
      <h1 class="display-xl">Photos</h1>
      <p class="body-l lede">Photos from trips and everyday life.</p>
    </div>
    <dl class="stats">
      {stats.map(([n, l]) => <div><dt class="sr-only">{l}</dt><dd><span class="n">{n}</span> <span class="l">{l}</span></dd></div>)}
    </dl>
  </section>

  <Painting src={darkroom} alt="A darkroom under a red safelight, prints pegged on a line to dry; a note reads “still drying”." w={1440} h={620} ink={false} focusX={720} mobileScale={0.6} priority />

  <section class="wrap prints" aria-labelledby="prints-title">
    <div class="prints-head">
      <h2 id="prints-title" class="display-l">Every print</h2>
      <p class="hand" aria-hidden="true">newest first, click one for the full view</p>
    </div>
    <PhotoGallery places={places} client:visible />
  </section>
</PageLayout>

<style>
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px 60px;
    padding-top: 80px;
    padding-bottom: 40px;
  }
  .lede {
    max-width: 520px;
    margin-top: 18px;
  }
  .stats {
    display: flex;
    gap: 32px;
    margin: 0;
  }
  .stats dd {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .stats .n {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1.1;
    color: var(--ink);
  }
  .stats .l {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-meta);
  }
  .prints {
    padding-top: 100px;
  }
  .prints-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 36px;
  }
  .prints-head .hand {
    font-size: 26px;
    color: var(--orange);
  }
  .prints :global(.photo-prints) {
    columns: 3;
    column-gap: 36px;
  }
  .prints :global(.photo-print-wrap) {
    break-inside: avoid;
    margin-bottom: 40px;
  }
  .prints :global(.photo-print) {
    display: block;
    width: 100%;
    padding: 12px 12px 14px;
    background: #fbf7ee;
    color: #1c2124;
    text-align: left;
    rotate: var(--r);
    box-shadow: 3px 10px 22px rgba(var(--shadow-ink), 0.26);
    cursor: zoom-in;
    transition: transform 0.45s var(--ease-spring), rotate 0.45s var(--ease-spring);
  }
  .prints :global(.photo-print:hover),
  .prints :global(.photo-print:focus-visible) {
    rotate: 0deg;
    transform: translate3d(0, -6px, 0) scale(1.02);
  }
  .prints :global(.photo-print img) {
    width: 100%;
    height: auto;
  }
  .prints :global(.photo-print-caption) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
  }
  .prints :global(.photo-print-no) {
    font-size: 12px;
    font-weight: 500;
    color: #b3430a; /* KTM orange, darkened for 4.5:1 on the print paper */
  }
  .prints :global(.photo-print-city) {
    font-family: var(--font-display);
    font-size: 18px;
  }
  .prints :global(.photo-print-date) {
    margin-left: auto;
    font-size: 12px;
    color: #6b6659;
  }
  @media (max-width: 1100px) {
    .prints :global(.photo-prints) {
      columns: 2;
    }
  }
  @media (max-width: 767px) {
    .page-head {
      padding-top: 32px;
    }
    .prints {
      padding-top: 64px;
    }
    .prints :global(.photo-prints) {
      columns: 1;
    }
  }
</style>
