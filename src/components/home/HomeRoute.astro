---
import { Image } from 'astro:assets';
import DualPainting from '@/components/journal/DualPainting.astro';
import route from '@/assets/paintings/route.png';
import routeM from '@/assets/paintings/route-m.png';
import ktm from '@/assets/bikes/ktm-390-adventure.png';
import { ROUTE } from '@/data/career';
---

<section class="section route" id="work-history" aria-labelledby="route-title">
  <div class="wrap section-head">
    <h2 id="route-title" class="display-l">The route so far</h2>
  </div>

  <DualPainting
    desktop={{ src: route, w: 1440, h: 720, edges: 'route' }}
    mobile={{ src: routeM, w: 390, h: 1330, edges: 'route-m' }}
    alt="A sunny desert road winding past the Abu Dhabi skyline, with a signpost at each stop of the career so far and the KTM riding toward the last one."
    tint
  >
    <ol class="stops">
      {ROUTE.map((s, i) => (
        <li class="stop">
          <div
            class:list={['at', 'sign', s.current && 'sign--now', 'grain']}
            style={`--x:${s.desktop.sign[0]};--y:${s.desktop.sign[1]};--r:${s.desktop.sign[2]};--mx:${s.mobile.sign[0]};--my:${s.mobile.sign[1]};--mr:${s.mobile.sign[2]}`}
            data-sound-hover="chalk"
          >
            <p class="sign-co">{s.company}</p>
            <p class="sign-meta">{s.year} · {s.role}</p>
          </div>
          <p
            class="at note hand"
            style={`--x:${s.desktop.note[0]};--y:${s.desktop.note[1]};--w:${s.desktop.note[2]};--mx:${s.mobile.note[0]};--my:${s.mobile.note[1]};--mw:${s.mobile.note[2]};--r:${[-2, 1.5, -1, 2][i % 4]}`}
          >
            <span data-ink-in style={`--reveal-delay:${0.5 + i * 0.25}s`}>{s.note}</span>
          </p>
        </li>
      ))}
    </ol>
    <div class="at route-bike" style="--x:1060;--y:400;--mx:83;--my:1071" aria-hidden="true" data-route-bike>
      <Image src={ktm} alt="" widths={[402]} sizes="220px" loading="lazy" />
    </div>
  </DualPainting>

  <div class="wrap section-foot">
    <a class="arrow-link" href="/resume.pdf" target="_blank" rel="noopener" data-sound-hover="tick">
      Download my CV
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.3 8H12M8.7 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>
</section>

<style>
  .stops {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sign {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
    padding: calc(12 * var(--u)) calc(18 * var(--u));
    border: calc(3 * var(--u)) solid #f3ead8;
    border-radius: calc(8 * var(--u));
    background: #2c5a5e;
    color: #f3ead8;
    white-space: nowrap;
    box-shadow: 0 calc(6 * var(--u)) calc(8 * var(--u)) rgba(20, 14, 6, 0.3);
    transform-origin: 50% 120%;
    transition: transform 0.5s var(--ease-spring);
    cursor: default;
  }
  .sign:hover,
  .sign:focus-visible {
    transform: rotate(-2.5deg) translateY(calc(-3 * var(--u)));
  }
  .sign--now {
    background: #e2560b;
  }
  .sign-co {
    font-family: var(--font-display);
    font-size: calc(26 * var(--u));
    line-height: 1.25;
  }
  .sign-meta {
    font-size: calc(12 * var(--u));
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Hand notes sit on a paper slip that blends into the painting: warm paper
     at 80%, a brown inner wash, rough torn edges, heavy grain. */
  .note {
    width: fit-content;
    max-width: calc(var(--w) * var(--u));
    padding: calc(8 * var(--u)) calc(14 * var(--u));
    border-radius: calc(1 * var(--u));
    background:
      url('../../assets/art/grain.png') 0 0 / 120px,
      rgba(236, 221, 194, 0.8);
    background-blend-mode: multiply, normal;
    box-shadow: inset 0 calc(1 * var(--u)) calc(10 * var(--u)) rgba(140, 102, 56, 0.35);
    clip-path: polygon(0.6% 4%, 11% 0.6%, 27% 3%, 44% 0%, 61% 2.6%, 78% 0.4%, 93% 2.2%, 100% 0.8%, 99.2% 34%, 100% 66%, 99.4% 97%, 87% 100%, 70% 97.6%, 52% 100%, 35% 97.8%, 18% 100%, 4% 98%, 0% 99.4%, 0.8% 66%, 0% 33%);
    font-size: calc(26 * var(--u));
    line-height: 1;
    color: #1c2124;
  }
  .note span {
    display: block;
  }

  .route-bike {
    width: calc(220 * var(--u));
    transform-origin: 50% 96%;
  }
  .route-bike :global(img) {
    width: 100%;
  }
  /* The ride in is scripted along the road (see the script below); until it
     starts, the bike waits out of sight. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .route-bike:not([data-rode]) {
      opacity: 0;
    }
  }

  .section-foot {
    margin-top: 24px;
  }

  @media (max-width: 767px) {
    .note {
      max-width: calc(var(--mw) * var(--u));
      font-size: calc(24 * var(--u));
    }
  }
</style>

<script>
  import { reducedMotion } from '@/scripts/site';

  // The KTM rides the last stretch of the road into its parking spot. The road
  // is one stroked path in the painting (Figma "Road"), so the bike follows its
  // centre line, tilting with it. Coordinates are the painting's Figma px.
  const ROADS = {
    desktop: {
      d: 'M 0 170 C 190 170 270 90 430 90 C 610 90 650 170 830 162 C 1010 154 1050 50 1210 40 C 1320 33 1400 10 1500 0',
      offset: [-30, 470],
      startX: 640, // where on the road the ride begins
    },
    mobile: {
      d: 'M 475 1.39 C 335 -10.61 195 59.39 75 55.39 C -25 61.39 -25 261.39 75 267.39 C 195 261.39 285 317.39 385 311.39 C 485 317.39 485 515.39 385 521.39 C 285 515.39 185 567.39 75 561.39 C -25 567.39 -25 795.39 75 801.39 C 195 797.39 325 835.39 475 827.39',
      offset: [-35, 390.5],
      startX: 0,
    },
  };
  const BIKE_W = 220;
  const CONTACT: [number, number] = [110, 135]; // wheels' contact point in the 220px bike
  const DURATION = 2600;

  /** Last length along the path, at or before `from`, whose x is <= `x`: a
   *  coarse walk back, then a 1px refine. */
  function backTo(at: (l: number) => { x: number }, from: number, x: number): number {
    let l = from;
    while (l > 0 && at(l).x > x) l -= 16;
    l = Math.max(0, l);
    while (l + 1 <= from && at(l + 1).x <= x) l += 1;
    return l;
  }

  function rideIn(bike: HTMLElement) {
    const mobile = window.matchMedia('(max-width: 767px)').matches;
    const road = mobile ? ROADS.mobile : ROADS.desktop;
    // Where the bike parks: the same --x/--y (or --mx/--my) its inline style sets.
    const css = getComputedStyle(bike);
    const park = [Number(css.getPropertyValue(mobile ? '--mx' : '--x')), Number(css.getPropertyValue(mobile ? '--my' : '--y'))];
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', road.d);
    const total = path.getTotalLength();
    const at = (l: number) => {
      const p = path.getPointAtLength(Math.max(0, Math.min(total, l)));
      return { x: p.x + road.offset[0], y: p.y + road.offset[1] };
    };
    const rest = { x: park[0] + CONTACT[0], y: park[1] + CONTACT[1] };
    // The parking spot: the last point on the road level with the parked bike.
    const end = backTo(at, total, rest.x);
    const start = backTo(at, end, road.startX);
    const drop = rest.y - at(end).y; // the bike sits a little below the centre line
    const angle = (l: number) => {
      const a = at(l - 2);
      const b = at(l + 2);
      return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
    };
    const finalAngle = angle(end);
    const u = bike.offsetWidth / BIKE_W;
    const t0 = performance.now();
    bike.dataset.rode = '';
    const frame = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - t0) / DURATION));
      const e = 1 - Math.pow(1 - t, 3);
      const l = start + (end - start) * e;
      const p = at(l);
      const dx = (p.x - rest.x) * u;
      const dy = (p.y + drop - rest.y) * u;
      // Lean with the road. The parked art is drawn level, so lean relative to
      // the slope at the parking spot and it settles to exactly 0.
      const lean = angle(l) - finalAngle;
      bike.style.transform = t < 1 ? `translate3d(${dx.toFixed(2)}px,${dy.toFixed(2)}px,0) rotate(${lean.toFixed(2)}deg)` : '';
      bike.style.opacity = String(Math.min(1, t * 6));
      if (t < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function setup() {
    const bike = document.querySelector<HTMLElement>('[data-route-bike]');
    if (!bike || bike.dataset.armed !== undefined || reducedMotion.matches) return;
    bike.dataset.armed = '';
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        setTimeout(() => rideIn(bike), 400);
      },
      { threshold: 0.5 },
    );
    io.observe(bike);
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
