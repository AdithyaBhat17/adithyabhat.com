---
import HeroRide from '@/components/home/HeroRide.astro';
import BikeArt from '@/components/journal/BikeArt.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-copy">
    <h1 id="hero-title" class="display-xl hero-title">
      I design and build software that feels
      <span class="hero-mark"><span class="accent">hand-made</span><svg class="hero-circle ink-stroke" data-draw viewBox="0 0 440 104" preserveAspectRatio="none" aria-hidden="true" style="--draw-delay:0.45s;--draw-dur:1.2s"><path d="M392 23.1C300 2.3 80 6.9 28 39.3c-40 27.7 92 55.5 232 50.8 140-4.6 184-32.3 140-57.8-28-13.9-80-18.5-120-16.2" pathLength="1" stroke-width="4" /></svg></span>.
    </h1>
    <p class="body-l hero-intro">
      A product engineer in Abu Dhabi, building thoughtful digital products. Currently shaping the Agentic AI platform at
      <a class="text-link" href="https://yellow.ai/" target="_blank" rel="noopener noreferrer">yellow.ai</a>.
    </p>
    <div class="hero-ctas">
      <a href="/work" class="btn btn--ink" data-sound-hover="tick">
        See my work
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.3 8H12M8.7 4l4 4-4 4" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a href="/contact" class="btn btn--ghost" data-sound-hover="tick">Say hello</a>
    </div>
  </div>

  <HeroRide
    class="hero-scene"
    alt="A watercolor of Abu Dhabi at dawn, with a KTM 390 Adventure riding along the road past the skyline, palms and dunes, on into the desert and the mountains."
    nightAlt="The same road at night under a crescent moon, with a Honda CB300R riding past the lit skyline."
  >
    <div class="hero-bikes">
      {[
        { key: 'ktm' as const, label: 'Rev the KTM 390 Adventure', sound: 'engine-ktm', eager: true },
        { key: 'cb' as const, label: 'Rev the Honda CB300R', sound: 'engine-cb', eager: false },
      ].map((b) => (
        <button type="button" class={`bike bike--${b.key}`} data-bike data-sound-click={b.sound} aria-label={b.label}>
          <BikeArt bike={b.key} sizes="(max-width: 767px) 280px, 28vw" eager={b.eager} />
        </button>
      ))}
    </div>
    <div class="hero-meta at-column" slot="outer">
      <p class="hero-caption scene-pill">
        <svg class="cap-sun" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="2.6" /><path d="M7 1v1.4M7 11.6V13M1 7h1.4M11.6 7H13M2.8 2.8l1 1M10.2 10.2l1 1M2.8 11.2l1-1M10.2 3.8l1-1" /></svg>
        <svg class="cap-moon" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M11.6 8.5A4.8 4.8 0 1 1 5.5 2.4a3.8 3.8 0 0 0 6.1 6.1Z" /></svg>
        <span><time data-ad-clock></time> in Abu Dhabi</span>
      </p>
      <button type="button" class="ride-toggle scene-pill" data-ride-toggle aria-pressed="false" aria-label="Pause the ride">
        <svg class="i-pause" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M5 3.5v7M9 3.5v7" /></svg>
        <svg class="i-play" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M5 3.2v7.6L10.8 7Z" /></svg>
      </button>
    </div>
  </HeroRide>
</section>

<style>
  .hero {
    position: relative;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-top: 56px;
  }

  .hero-title {
    max-width: 980px;
  }

  .hero-mark {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .hero-circle {
    position: absolute;
    left: -5.5%;
    top: -16%;
    width: 108.6%;
    height: 137%;
    overflow: visible;
    pointer-events: none;
  }

  .hero-intro {
    max-width: 560px;
    margin-top: 26px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  /* The scene tucks up under the copy, as in the painting's frame. */
  .hero :global(.hero-scene) {
    margin-top: calc(-76 * 100vw / 1440);
    z-index: 1;
  }

  .hero-bikes {
    position: absolute;
    inset: 0;
    view-transition-name: hero-bikes;
    pointer-events: none;
  }

  .bike {
    position: absolute;
    top: calc(313 * var(--u));
    width: calc(400 * var(--u));
    padding: 0;
    border-radius: 12px;
    pointer-events: auto;
    transform-origin: 60% 90%;
    transition: transform 1.3s cubic-bezier(0.55, 0, 0.7, 0.2), opacity 0.5s ease 0.8s;
  }
  .bike--ktm {
    left: calc(701 * var(--u));
    --rear-turn: 1.57s;
    --front-turn: 1.7s;
  }
  .bike--cb {
    left: calc(721 * var(--u));
    --rear-turn: 1.51s;
    --front-turn: 1.45s;
  }
  /* Riding: wheels turn at road speed (210 px/s over each tyre's circumference),
     and the bike bobs a little on its suspension. Paused with the scene. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.ride.is-riding .bike-art) :global(.part--wheelRear) {
      animation: turn var(--rear-turn) linear infinite;
    }
    :global(.ride.is-riding .bike-art) :global(.part--wheelFront) {
      animation: turn var(--front-turn) linear infinite;
    }
    :global(.ride.is-riding .bike-art) :global(.part--body) {
      animation: bob 0.42s ease-in-out infinite alternate;
    }
  }
  @keyframes turn {
    to {
      transform: rotate(1turn);
    }
  }
  @keyframes bob {
    to {
      transform: translate3d(0, calc(-0.8 * var(--u)), 0);
    }
  }
  /* The bike that isn't in this theme's painting has ridden out of frame. */
  .bike--cb,
  :global([data-theme='dark']) .bike--ktm {
    visibility: hidden;
    opacity: 0;
    transition: transform 1.3s cubic-bezier(0.55, 0, 0.7, 0.2), opacity 0.4s ease 0.9s, visibility 0s linear 1.4s;
  }
  .bike--cb {
    transform: translate3d(calc(-1100 * var(--u)), 0, 0);
  }
  :global([data-theme='dark']) .bike--ktm {
    transform: translate3d(calc(900 * var(--u)), 0, 0);
  }
  /* The arriving bike rides in once the other has pulled away. */
  :global([data-theme='light']) .bike--ktm,
  :global([data-theme='dark']) .bike--cb {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: transform 1.5s cubic-bezier(0.2, 0.7, 0.25, 1) 0.35s, opacity 0.3s ease 0.35s, visibility 0s;
  }
  /* No riding on first paint: transitions only while the theme is switching. */
  :global(html:not(.theme-switching)) .bike {
    transition: none;
  }
  .bike:focus-visible {
    outline-offset: -6px;
  }
  /* Click a bike: a little rev and rock. */
  .bike:global(.is-revving) :global(.bike-art) {
    animation: rev 0.7s var(--ease-out);
  }
  @keyframes rev {
    0% { transform: none; }
    15% { transform: translate3d(-3px, 0, 0) rotate(-1.2deg); }
    30% { transform: translate3d(2px, -1px, 0) rotate(0.8deg); }
    45% { transform: translate3d(-2px, 0, 0) rotate(-0.6deg); }
    60% { transform: translate3d(1px, 0, 0) rotate(0.3deg); }
    100% { transform: none; }
  }

  .hero-meta {
    position: absolute;
    bottom: clamp(12px, 1.32vw, 32px);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ride-toggle {
    justify-content: center;
    width: 32px;
    padding: 0;
  }
  .ride-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ride-toggle .i-play {
    display: none;
    fill: currentColor;
  }
  .ride-toggle[aria-pressed='true'] .i-play {
    display: block;
  }
  .ride-toggle[aria-pressed='true'] .i-pause {
    display: none;
  }
  /* Nothing moves with reduced motion, so there's nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
    .ride-toggle {
      display: none;
    }
  }
  .hero-caption {
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-caption svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .cap-moon {
    display: none;
  }
  /* Sun or moon follows the time in Abu Dhabi, not the theme. Before the
     script runs, it falls back to the theme. */
  :global([data-theme='dark']) .hero-caption:not([data-daytime]) .cap-sun,
  .hero-caption[data-daytime='night'] .cap-sun {
    display: none;
  }
  :global([data-theme='dark']) .hero-caption:not([data-daytime]) .cap-moon,
  .hero-caption[data-daytime='night'] .cap-moon {
    display: inline;
  }
  .hero-caption[data-daytime='day'] .cap-moon {
    display: none;
  }
  .hero-caption[data-daytime='day'] .cap-sun {
    display: inline;
  }
  [data-ad-clock] {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .hero-copy {
      padding-top: 28px;
    }
    .hero-intro {
      margin-top: 20px;
    }
    .hero-ctas {
      margin-top: 20px;
    }
    .hero :global(.hero-scene) {
      margin-top: -5px;
    }
    .hero-meta {
      bottom: 16px;
    }
  }
</style>

<script>
  // Live local time in Abu Dhabi (Gulf Standard Time, no DST).
  const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dubai', hour: 'numeric', minute: '2-digit' });
  const hourFmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dubai', hour: 'numeric', hourCycle: 'h23' });
  let timer = 0;

  function startClock() {
    const el = document.querySelector<HTMLTimeElement>('[data-ad-clock]');
    clearTimeout(timer);
    if (!el) return;
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
      const h = Number(hourFmt.format(now));
      el.closest<HTMLElement>('.hero-caption')!.dataset.daytime = h >= 6 && h < 18 ? 'day' : 'night';
      // Re-run at the top of the next minute.
      timer = window.setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
    };
    tick();
  }

  startClock();
  document.addEventListener('astro:page-load', startClock);
  document.addEventListener('astro:before-swap', () => clearTimeout(timer));
</script>
