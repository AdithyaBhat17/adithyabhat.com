---
import DualPainting from '@/components/journal/DualPainting.astro';
import cafe from '@/assets/paintings/cafe.png';
import cafeFg from '@/assets/paintings/cafe-fg.png';
import cafeM from '@/assets/paintings/cafe-m.png';
import cafeMFg from '@/assets/paintings/cafe-m-fg.png';
import { TESTIMONIALS } from '@/data/testimonials';

// Where each note lies on the table: desktop [x, y, rot, width], mobile [x, y, rot].
const SPOTS: { d: [number, number, number, number]; m: [number, number, number] }[] = [
  { d: [92, 120, -5, 320], m: [26, 84, 4] },
  { d: [470, 90, 3, 250], m: [104, 450, -3] },
  { d: [788, 178, -2, 320], m: [30, 840, 3] },
  { d: [1110, 110, 5, 320], m: [40, 1290, -4] },
];
const notes = TESTIMONIALS.slice(0, SPOTS.length);
---

<section class="section kind" id="kind-words" aria-labelledby="kind-title">
  <div class="wrap section-head">
    <h2 id="kind-title" class="display-l">Kind words</h2>
  </div>

  <DualPainting
    desktop={{ src: cafe, fg: cafeFg, w: 1440, h: 760, edges: 'cafe' }}
    mobile={{ src: cafeM, fg: cafeMFg, w: 390, h: 1680 }}
    alt="A wooden café table in window light with espresso cups, coffee rings and a pen; notes from colleagues are scattered across it."
    tint
  >
    <ul class="notes">
      {notes.map((t, i) => {
        const s = SPOTS[i];
        const receipt = t.paper === 'receipt';
        return (
          <li
            class:list={['at', 'paper', receipt ? 'receipt' : 'napkin']}
            style={`--x:${s.d[0]};--y:${s.d[1]};--r:${s.d[2]};--w:${s.d[3]};--mx:${s.m[0]};--my:${s.m[1]};--mr:${s.m[2]};--reveal-delay:${0.2 + i * 0.1}s`}
            data-sound-hover="scratch"
          >
            <figure>
              {receipt && (
                <p class="receipt-head" aria-hidden="true">
                  Café · Table 04<br />Flat white × 1&nbsp;&nbsp;&nbsp;Espresso × 2
                  <span class="receipt-dots">· · · · · · · · · · · · · · · · · ·</span>
                </p>
              )}
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <span class="sig hand">{t.name}</span>
                <span class="who">{t.role}, {t.company}</span>
              </figcaption>
            </figure>
          </li>
        );
      })}
    </ul>
  </DualPainting>
</section>

<style>
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .paper {
    z-index: 2;
    width: calc(var(--w) * var(--u));
    color: #1c2124;
    transition: transform 0.5s var(--ease-spring), rotate 0.5s var(--ease-spring);
    isolation: isolate;
  }
  .paper figure {
    margin: 0;
    height: 100%;
  }
  .paper::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: 0 calc(24 * var(--u)) calc(34 * var(--u)) rgba(25, 15, 5, 0.4);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .paper:hover,
  .paper:focus-within {
    rotate: 0deg;
    transform: translate3d(0, calc(-10 * var(--u)), 0) scale(1.05);
    z-index: 5;
  }
  .paper:hover::before,
  .paper:focus-within::before {
    opacity: 1;
  }

  .napkin {
    padding: calc(34 * var(--u)) calc(32 * var(--u));
    background: #fbf8f1;
    border: calc(1.5 * var(--u)) dashed #d8cdb8;
    border-radius: calc(3 * var(--u));
    box-shadow: calc(2 * var(--u)) calc(8 * var(--u)) calc(14 * var(--u)) rgba(25, 15, 5, 0.28);
  }
  .receipt {
    padding: calc(26 * var(--u)) calc(24 * var(--u)) calc(40 * var(--u));
    background: #f7f5ef;
    box-shadow: calc(2 * var(--u)) calc(8 * var(--u)) calc(14 * var(--u)) rgba(25, 15, 5, 0.28);
  }
  /* Torn zigzag foot of the receipt. */
  .receipt::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-11 * var(--u));
    height: calc(12 * var(--u));
    background: #f7f5ef;
    clip-path: polygon(0 0, 100% 0, 100% 33%, 98% 100%, 96% 33%, 94% 100%, 92% 33%, 90% 100%, 88% 33%, 86% 100%, 84% 33%, 82% 100%, 80% 33%, 78% 100%, 76% 33%, 74% 100%, 72% 33%, 70% 100%, 68% 33%, 66% 100%, 64% 33%, 62% 100%, 60% 33%, 58% 100%, 56% 33%, 54% 100%, 52% 33%, 50% 100%, 48% 33%, 46% 100%, 44% 33%, 42% 100%, 40% 33%, 38% 100%, 36% 33%, 34% 100%, 32% 33%, 30% 100%, 28% 33%, 26% 100%, 24% 33%, 22% 100%, 20% 33%, 18% 100%, 16% 33%, 14% 100%, 12% 33%, 10% 100%, 8% 33%, 6% 100%, 4% 33%, 2% 100%, 0 33%);
  }
  .receipt-head {
    margin-bottom: calc(12 * var(--u));
    font-size: calc(11 * var(--u));
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: #6b6659;
    white-space: nowrap;
  }
  .receipt-dots {
    display: block;
    margin-top: calc(12 * var(--u));
    color: #b9b1a1;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(17 * var(--u));
    line-height: 1.5;
  }
  .receipt blockquote {
    font-size: calc(16 * var(--u));
  }
  figcaption {
    display: flex;
    flex-direction: column;
    margin-top: calc(14 * var(--u));
  }
  .sig {
    font-size: calc(34 * var(--u));
    color: #e2560b;
    transition: clip-path 0.8s var(--ease-in-out);
  }
  .receipt .sig {
    font-size: calc(32 * var(--u));
  }
  /* Hover: the signature re-inks. */
  .paper:hover .sig {
    animation: reink 0.9s var(--ease-in-out);
  }
  @keyframes reink {
    0% { clip-path: inset(0 100% 0 0); }
    100% { clip-path: inset(0 0 0 0); }
  }
  .who {
    font-size: calc(11 * var(--u));
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #6b6659;
  }

  @media (max-width: 767px) {
    .napkin {
      width: calc(320 * var(--u));
    }
    .receipt {
      width: calc(250 * var(--u));
    }
    blockquote {
      font-size: calc(16.5 * var(--u));
    }
  }
</style>
