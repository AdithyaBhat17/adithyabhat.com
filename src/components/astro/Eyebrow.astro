---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['eyebrow', className]}>
  <slot />
</span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
