---
/**
 * A torn-edge painting whose mobile art is a different composition (e.g. the
 * route winding down the page). One DOM for both: children are positioned with
 * `.at` and the vars --x/--y/--r (desktop Figma px) and --mx/--my/--mr (mobile),
 * all multiplied by --u, which is one Figma px of whichever composition shows.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import edgesData from '@/assets/paintings/edges.json';

interface Art {
  src: ImageMetadata;
  fg?: ImageMetadata;
  w: number;
  h: number;
  edges?: keyof typeof edgesData;
}

interface Props {
  desktop: Art;
  mobile: Art;
  alt: string;
  tint?: boolean;
  class?: string;
}

const { desktop, mobile, alt, tint = false, class: className } = Astro.props;

async function srcset(img: ImageMetadata, widths: number[]) {
  const ws = widths.filter((w) => w <= img.width);
  const [avif, webp] = await Promise.all([
    getImage({ src: img, widths: ws, format: 'avif', quality: 58 }),
    getImage({ src: img, widths: ws, format: 'webp', quality: 72 }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
}

const d = await srcset(desktop.src, [720, 1080, desktop.src.width]);
const m = await srcset(mobile.src, [mobile.src.width]);
const dfg = desktop.fg ? await srcset(desktop.fg, [720, 1080, desktop.fg.width]) : null;
const mfg = mobile.fg ? await srcset(mobile.fg, [mobile.fg.width]) : null;
const mSizes = `${mobile.w}px`;

type Edge = { top?: string; bottom?: string; topT?: string; bottomT?: string };
const edges = edgesData as Record<string, Edge>;
const dEdge = desktop.edges ? edges[desktop.edges] : undefined;
const mEdge = mobile.edges ? edges[mobile.edges] : undefined;
---

<div
  class:list={['dual', tint && 'dual--tint', className]}
  style={`--dw:${desktop.w};--dh:${desktop.h};--mw:${mobile.w};--mh:${mobile.h}`}
  data-observe
>
  <picture class="dual-art">
    <source media="(max-width: 767px)" type="image/avif" srcset={m.avif} sizes={mSizes} />
    <source media="(max-width: 767px)" type="image/webp" srcset={m.webp} sizes={mSizes} />
    <source type="image/avif" srcset={d.avif} sizes="100vw" />
    <source type="image/webp" srcset={d.webp} sizes="100vw" />
    <img src={d.src} alt={alt} width={desktop.w} height={desktop.h} loading="lazy" decoding="async" />
  </picture>

  {dEdge && (
    <svg class="dual-ink dual-ink--d ink-stroke" data-draw viewBox={`0 0 ${desktop.w} ${desktop.h}`} preserveAspectRatio="none" aria-hidden="true" style="--draw-dur:1.6s">
      {dEdge.top && <path d={dEdge.top} transform={dEdge.topT} pathLength="1" />}
      {dEdge.bottom && <path d={dEdge.bottom} transform={dEdge.bottomT} pathLength="1" />}
    </svg>
  )}
  {mEdge && (
    <svg class="dual-ink dual-ink--m ink-stroke" data-draw viewBox={`0 0 ${mobile.w} ${mobile.h}`} preserveAspectRatio="none" aria-hidden="true" style="--draw-dur:1.6s">
      {mEdge.top && <path d={mEdge.top} transform={mEdge.topT} pathLength="1" />}
      {mEdge.bottom && <path d={mEdge.bottom} transform={mEdge.bottomT} pathLength="1" />}
    </svg>
  )}

  <slot />

  {(dfg || mfg) && (
    <picture class="dual-fg" aria-hidden="true">
      {mfg && <source media="(max-width: 767px)" type="image/avif" srcset={mfg.avif} sizes={mSizes} />}
      {mfg && <source media="(max-width: 767px)" type="image/webp" srcset={mfg.webp} sizes={mSizes} />}
      {dfg && <source type="image/avif" srcset={dfg.avif} sizes="100vw" />}
      {dfg && <source type="image/webp" srcset={dfg.webp} sizes="100vw" />}
      <img src={(dfg ?? mfg)!.src} alt="" width={desktop.w} height={desktop.h} loading="lazy" decoding="async" />
    </picture>
  )}
</div>

<style>
  .dual {
    --u: calc(100cqw / var(--dw));
    position: relative;
    width: 100%;
    aspect-ratio: var(--dw) / var(--dh);
    container-type: inline-size;
  }
  .dual-art,
  .dual-art img,
  .dual-fg,
  .dual-fg img,
  .dual-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dual-fg {
    z-index: 3;
    pointer-events: none;
  }
  .dual-ink {
    overflow: visible;
    pointer-events: none;
    z-index: 4;
  }
  .dual-ink path {
    stroke-width: 2.4;
  }
  .dual-ink--m {
    display: none;
  }
  .dual--tint .dual-art,
  .dual--tint .dual-fg {
    filter: var(--painting-tint);
  }

  /* Children placed in Figma coordinates. */
  .dual :global(.at) {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    rotate: calc(var(--r, 0) * 1deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .dual-art {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 1.1s var(--ease-in-out);
    }
    :global(.js) .dual.is-in .dual-art {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 767px) {
    .dual {
      --u: calc(100cqw / var(--mw));
      aspect-ratio: var(--mw) / var(--mh);
      max-width: 520px;
      margin-inline: auto;
    }
    .dual-ink--d {
      display: none;
    }
    .dual-ink--m {
      display: block;
    }
    .dual :global(.at) {
      left: calc(var(--mx, var(--x)) * var(--u));
      top: calc(var(--my, var(--y)) * var(--u));
      rotate: calc(var(--mr, var(--r, 0)) * 1deg);
    }
  }
</style>
