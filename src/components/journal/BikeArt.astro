---
/**
 * A bike in four stacked layers (shadow, rear wheel, front wheel, body) so the
 * wheels can be turned. The parent sets the width; wheels rotate around their
 * hubs via transform-origin. Animate `.part--wheelRear` / `.part--wheelFront`
 * and `.part--body` from the parent with :global().
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { BIKES, BIKE_PARTS, type BikeKey } from '@/data/bikes';

interface Props {
  bike: BikeKey;
  /** Rendered width in CSS px at most, for the image size hint. */
  sizes: string;
  width?: number;
  eager?: boolean;
  class?: string;
}
const { bike, sizes, width = 400, eager = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/ride/bike-*.png', { eager: true });
const pivot = BIKES[bike];
---

<span class:list={['bike-art', className]} style={`--rear:${pivot.rear};--front:${pivot.front}`} aria-hidden="true">
  {BIKE_PARTS.map((p) => (
    <Image
      src={files[`/src/assets/ride/bike-${bike}-${p}.png`].default}
      alt=""
      class={`part part--${p}`}
      widths={[width]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority="low"
      draggable="false"
    />
  ))}
</span>

<style>
  .bike-art {
    position: relative;
    display: block;
    aspect-ratio: 400 / 256;
  }
  .part {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .part--wheelRear {
    transform-origin: var(--rear);
  }
  .part--wheelFront {
    transform-origin: var(--front);
  }
</style>
