---
/**
 * A full-bleed, torn-edge watercolor panel.
 *
 * The raster (pre-composited from Figma, see scripts/art) is served as
 * AVIF/WebP srcsets. The torn edges are re-drawn as live orange ink strokes
 * that draw on when the panel scrolls in.
 *
 * Children of the default slot are positioned in the painting's own Figma
 * coordinates via `--u` (one Figma px): `left: calc(140 * var(--u))`.
 * On mobile the composition is shown at `mobileScale` and cropped around
 * `focusX`, so the art keeps its detail instead of shrinking to a sliver.
 * The `outer` slot sits in the visible box (e.g. swipe strips on mobile).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import edgesData from '@/assets/paintings/edges.json';

interface Props {
  src: ImageMetadata;
  /** Optional art-directed crop for small screens: [x, width] in Figma px. */
  mobileSrc?: ImageMetadata;
  mobileCrop?: [number, number];
  alt: string;
  /** Figma frame size of the painting. */
  w: number;
  h: number;
  edges?: keyof typeof edgesData;
  /** Ink colour/visibility. `false` hides the strokes. */
  ink?: boolean;
  priority?: boolean;
  mobileScale?: number;
  focusX?: number;
  /** Tint in dark mode (for paintings with no explicit night art). */
  tint?: boolean;
  class?: string;
  id?: string;
  label?: string;
  /** Night-art variant shown in dark mode (crossfades on theme change). */
  nightSrc?: ImageMetadata;
  nightMobileSrc?: ImageMetadata;
  nightAlt?: string;
  /** Mobile: let the visitor swipe across the full scaled composition instead of cropping. */
  mobileSwipe?: boolean;
}

const {
  src,
  mobileSrc,
  mobileCrop,
  alt,
  w,
  h,
  edges,
  ink = true,
  priority = false,
  mobileScale = 1,
  focusX = w / 2,
  tint = false,
  class: className,
  id,
  label,
  nightSrc,
  nightMobileSrc,
  nightAlt,
  mobileSwipe = false,
} = Astro.props;

const quality = 58;

async function sources(img: ImageMetadata, mImg?: ImageMetadata) {
  const widths = [720, 1080, img.width].filter((x, i, a) => x <= img.width && a.indexOf(x) === i);
  const [avif, webp, fallback] = await Promise.all([
    getImage({ src: img, widths, format: 'avif', quality }),
    getImage({ src: img, widths, format: 'webp', quality: 72 }),
    getImage({ src: img, width: Math.min(1080, img.width), format: 'webp', quality: 72 }),
  ]);
  let mobile: { avif: string; webp: string; sizes: string } | null = null;
  if (mImg && mobileCrop) {
    const mw = [Math.round(mImg.width / 2), mImg.width];
    const [ma, mwp] = await Promise.all([
      getImage({ src: mImg, widths: mw, format: 'avif', quality }),
      getImage({ src: mImg, widths: mw, format: 'webp', quality: 72 }),
    ]);
    mobile = { avif: ma.srcSet.attribute, webp: mwp.srcSet.attribute, sizes: `${Math.round(mobileCrop[1] * mobileScale)}px` };
  }
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: fallback.src, mobile };
}

const variants = [{ key: 'day', ...(await sources(src, mobileSrc)) }];
if (nightSrc) variants.push({ key: 'night', ...(await sources(nightSrc, nightMobileSrc)) });
const mobile = variants[0].mobile;

const edge = edges ? (edgesData as Record<string, { top?: string; bottom?: string }>)[edges] : undefined;
const style = [
  `--pw:${w}`,
  `--ph:${h}`,
  `--ms:${mobileScale}`,
  `--fx:${focusX}`,
  mobileCrop ? `--cx:${mobileCrop[0]};--cw:${mobileCrop[1]}` : '',
].filter(Boolean).join(';');
---

<div
  class:list={['painting', tint && 'painting--tint', mobile && 'has-crop', priority && 'painting--static', mobileSwipe && 'painting--swipe', className]}
  style={style}
  id={id}
  role={label ? 'group' : undefined}
  aria-label={label}
  data-observe
>
  <div class="painting-inner">
    {variants.map((v) => {
      const eager = priority && v.key === 'day';
      return (
        <picture class:list={['painting-art', nightSrc && `is-${v.key}`]}>
          {v.mobile && <source media="(max-width: 767px)" type="image/avif" srcset={v.mobile.avif} sizes={v.mobile.sizes} />}
          {v.mobile && <source media="(max-width: 767px)" type="image/webp" srcset={v.mobile.webp} sizes={v.mobile.sizes} />}
          <source type="image/avif" srcset={v.avif} sizes="100vw" />
          <source type="image/webp" srcset={v.webp} sizes="100vw" />
          <img
            src={v.src}
            alt={v.key === 'night' ? (nightAlt ?? alt) : alt}
            width={w}
            height={h}
            loading={eager ? 'eager' : 'lazy'}
            decoding={eager ? 'sync' : 'async'}
            fetchpriority={eager ? 'high' : priority ? 'low' : 'auto'}
            data-art={nightSrc ? v.key : undefined}
          />
        </picture>
      );
    })}
    {nightSrc && priority && (
      <script is:inline>
        (function () {
          // Dark visitors: promote the night painting to the LCP fetch.
          if (document.documentElement.dataset.theme !== 'dark') return;
          var s = document.currentScript, i = s && s.parentNode && s.parentNode.querySelector('img[data-art=night]');
          if (i) { i.loading = 'eager'; i.setAttribute('fetchpriority', 'high'); }
        })();
      </script>
    )}
    {ink && edge && (
      <svg class="painting-ink ink-stroke" data-draw viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true" style="--draw-dur:1.6s">
        {edge.top && <path d={edge.top} pathLength="1" />}
        {edge.bottom && <path d={edge.bottom} pathLength="1" />}
      </svg>
    )}
    <slot />
  </div>
  <slot name="outer" />
</div>

<style>
  .painting {
    position: relative;
    width: 100%;
    container-type: inline-size;
    aspect-ratio: var(--pw) / var(--ph);
  }

  .painting-inner {
    --u: calc(100cqw / var(--pw));
    position: absolute;
    inset: 0;
  }

  .painting-art,
  .painting-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .painting-art img {
    object-fit: fill;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Day/night variants: only the active one is displayed (so the other never
     loads up front); both show while the theme is switching, to crossfade. */
  .painting-art.is-night {
    display: none;
  }
  :global([data-theme='dark']) .painting-art.is-night {
    display: block;
  }
  :global([data-theme='dark']) .painting-art.is-day {
    display: none;
  }
  :global(.theme-switching) .painting-art.is-day,
  :global(.theme-switching) .painting-art.is-night {
    display: block;
    transition: opacity 0.9s ease;
  }
  :global(.theme-switching[data-theme='dark']) .painting-art.is-day,
  :global(.theme-switching[data-theme='light']) .painting-art.is-night {
    opacity: 0;
  }

  .painting--tint .painting-art {
    filter: var(--painting-tint);
    transition: filter 0.6s ease;
  }

  .painting-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .painting-ink path {
    stroke-width: 2.4;
  }

  /* Unroll: the panel opens top → bottom like a sheet being laid down. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .painting-art {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 1.1s var(--ease-in-out);
    }
    :global(.js) .painting.is-in .painting-art,
    :global(.js) .painting--static .painting-art {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 767px) {
    .painting {
      aspect-ratio: auto;
      height: calc(var(--ph) * var(--ms) * 1px);
      overflow: hidden;
      container-type: normal;
    }
    .painting-inner {
      --u: calc(var(--ms) * 1px);
      inset: 0 auto 0 calc(50% - var(--fx) * var(--u));
      width: calc(var(--pw) * var(--u));
    }
    .painting--swipe {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .painting--swipe::-webkit-scrollbar {
      display: none;
    }
    .painting--swipe .painting-inner {
      left: 0;
    }
    .has-crop .painting-art {
      left: calc(var(--cx) * var(--u));
      width: calc(var(--cw) * var(--u));
    }
    .has-crop .painting-art img {
      object-fit: cover;
    }
  }
</style>
