---
import BaseLayout from './BaseLayout.astro';
import Nav from '@/components/journal/Nav.astro';
import Footer from '@/components/journal/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Show the closing "Got something in mind?" CTA above the footer. */
  cta?: boolean;
}

const { title, description, image, cta = true } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <Nav />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer cta={cta} />
  <slot name="head" slot="head" />
</BaseLayout>
